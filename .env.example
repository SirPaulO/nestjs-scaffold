# Application
NODE_ENV=development
PORT=3000
APP_DEBUG=false

# CORS (comma-separated origins, supports wildcard *).
# REQUIRED — the app fails to boot if this is unset (fail-closed default;
# never falls back to an unrestricted "*" origin with credentials enabled).
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Database
# DATABASE_HOST/PORT have dev-friendly defaults if unset; USERNAME/PASSWORD/NAME
# do NOT — the app refuses to boot without them (no weak default credentials).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=backend
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# When DATABASE_SSL=true, certificates are verified by default
# (rejectUnauthorized: true). Supply a custom CA bundle if the server's cert
# isn't signed by a public CA:
DATABASE_SSL_CA=
# Explicit, informed opt-out ONLY — disables certificate verification
# (accepts any certificate, including a MITM's). Leave unset/true.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SYNCHRONIZE=false
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=2000

# Valkey / Redis
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USER=default
VALKEY_PASSWORD=changeme
VALKEY_DB=0

# Rate limiting — wired globally via @nestjs/throttler (ThrottlerGuard)
# RATE_LIMIT_MAX requests per RATE_LIMIT_TTL milliseconds, per tracked client.
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Internal API keys (comma-separated) — used by ApiKeyGuard on internal endpoints
SYSTEM_API_KEYS=change-me-key-1,change-me-key-2

# Auth — JWT (required; JwtStrategy refuses to start without JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=1h

# Logging
LOG_LEVEL=debug

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Never sends IPs/cookies/request bodies verbatim by default — opt in
# explicitly and only if you understand what PII will reach Sentry.
SENTRY_SEND_DEFAULT_PII=false
