# Application
NODE_ENV=development
PORT=3000
APP_DEBUG=false

# CORS (comma-separated origins, supports wildcard *)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=backend
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=false
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=2000

# Valkey / Redis
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USER=default
VALKEY_PASSWORD=changeme
VALKEY_DB=0

# Rate limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Internal API keys (comma-separated) — used by ApiKeyGuard on internal endpoints
SYSTEM_API_KEYS=change-me-key-1,change-me-key-2

# Logging
LOG_LEVEL=debug

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
